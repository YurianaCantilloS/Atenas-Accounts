{
  "version": 2,
  "builds": [
    { "src": "frontend/api/subir-imagen.js", "use": "@vercel/node" },
    { "src": "frontend/index.html", "use": "@vercel/static" },
    { "src": "frontend/assets/**", "use": "@vercel/static" },
    { "src": "frontend/*.sql", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/subir-imagen\\.js", "dest": "/frontend/api/subir-imagen.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
