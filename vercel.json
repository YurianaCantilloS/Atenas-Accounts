{
  "version": 2,
  "builds": [
    {
      "src": "api/subir-imagen.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/subir-imagen",
      "dest": "/api/subir-imagen.js"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
